{
  "name": "@qmail/worker",
  "version": "1.0.0",
  "description": "Qmail Cloudflare Worker backend",
  "main": "src/index.ts",
  "scripts": {
    "dev": "npx wrangler dev",
    "deploy": "npx wrangler deploy",
    "db:migrate": "npx wrangler d1 execute DB --local --file=./src/db/schema.sql",
    "db:migrate:prod": "npx wrangler d1 execute DB --remote --file=./src/db/schema.sql",
    "tail": "npx wrangler tail"
  },
  "dependencies": {
    "@qmail/brevo-api": "workspace:*",
    "@qmail/cloudflare-email-api": "workspace:*",
    "@simplewebauthn/server": "^13.3.3",
    "hono": "^4.13.14",
    "postal-mime": "^2.7.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "typescript": "~5.9.3"
  }
}
