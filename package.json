{
  "name": "qmail",
  "version": "1.0.0",
  "private": true,
  "description": "Free custom email solution using Cloudflare Email Routing and Mailgun",
  "scripts": {
    "dev": "pnpm --filter @qmail/worker dev",
    "dev:frontend": "pnpm --filter @qmail/frontend dev",
    "build": "pnpm -r build",
    "build:frontend": "pnpm --filter @qmail/frontend build",
    "deploy": "pnpm build && pnpm --filter @qmail/worker run deploy",
    "db:migrate": "pnpm --filter @qmail/worker db:migrate",
    "db:migrate:prod": "pnpm --filter @qmail/worker db:migrate:prod"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "wrangler": "^4.152.0"
  }
}
